{
  "scope": "aux4",
  "name": "curl",
  "version": "1.3.1",
  "description": "HTTP client with OAuth2 PKCE, file upload/download, and NDJSON streaming support",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "curl",
    "http",
    "oauth",
    "ndjson",
    "stream"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "curl",
          "execute": [
            "profile:curl"
          ],
          "help": {
            "text": "HTTP client with stdin body and NDJSON streaming support"
          }
        }
      ]
    },
    {
      "name": "curl",
      "commands": [
        {
          "name": "request",
          "execute": [
            "${packageDir}/aux4-curl request values(method, url, header*, body, showHeaders, upload*, uploadField, output, bodyFile, status, maxTime)"
          ],
          "help": {
            "text": "Make an HTTP request",
            "variables": [
              {
                "name": "method",
                "text": "HTTP method",
                "default": "GET"
              },
              {
                "name": "url",
                "text": "Request URL",
                "arg": true
              },
              {
                "name": "header",
                "text": "Request header (Name: Value)",
                "default": "",
                "multiple": true
              },
              {
                "name": "body",
                "text": "Request body",
                "default": ""
              },
              {
                "name": "showHeaders",
                "text": "Show response headers",
                "default": "false"
              },
              {
                "name": "upload",
                "text": "File to upload as multipart/form-data; repeatable, use field=path to name the part",
                "default": "",
                "multiple": true
              },
              {
                "name": "uploadField",
                "text": "Form field name for the uploaded file",
                "default": "file"
              },
              {
                "name": "output",
                "text": "Write the response body to this file instead of stdout",
                "default": ""
              },
              {
                "name": "bodyFile",
                "text": "Send the contents of this file as the raw request body",
                "default": ""
              },
              {
                "name": "status",
                "text": "Print only the numeric HTTP status code and exit 0 (transport failure prints nothing and exits 1)",
                "default": "false"
              },
              {
                "name": "maxTime",
                "text": "Request timeout in seconds (decimals allowed, e.g. 2.5); 0 means no timeout",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "stream",
          "execute": [
            "stdin:${packageDir}/aux4-curl stream values(method, url, header*, concurrency, maxTime)"
          ],
          "help": {
            "text": "Stream NDJSON from stdin, call URL per line, output NDJSON",
            "variables": [
              {
                "name": "method",
                "text": "HTTP method",
                "default": "POST"
              },
              {
                "name": "url",
                "text": "Request URL",
                "arg": true
              },
              {
                "name": "header",
                "text": "Request header (Name: Value)",
                "default": "",
                "multiple": true
              },
              {
                "name": "concurrency",
                "text": "Number of concurrent requests",
                "default": "1"
              },
              {
                "name": "maxTime",
                "text": "Per-request timeout in seconds (decimals allowed, e.g. 2.5); 0 means no timeout. A timeout yields {\"error\",\"input\",\"status\":0} for that line",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "oauth",
          "execute": [
            "profile:curl:oauth"
          ],
          "help": {
            "text": "OAuth2 authentication management"
          }
        },
        {
          "name": "auth",
          "execute": [
            "profile:curl:auth"
          ],
          "help": {
            "text": "Machine-to-machine authentication with a credential endpoint"
          }
        },
        {
          "name": "auth-request",
          "execute": [
            "${packageDir}/aux4-curl auth-request values(provider, tokenFile, method, url, header*, body, showHeaders, upload*, uploadField, output, bodyFile, auth)"
          ],
          "help": {
            "text": "Make an authenticated HTTP request using OAuth2 token",
            "variables": [
              {
                "name": "provider",
                "text": "OAuth provider name"
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<provider>.json)",
                "default": ""
              },
              {
                "name": "method",
                "text": "HTTP method",
                "default": "GET"
              },
              {
                "name": "url",
                "text": "Request URL",
                "arg": true
              },
              {
                "name": "header",
                "text": "Request header (Name: Value)",
                "default": "",
                "multiple": true
              },
              {
                "name": "body",
                "text": "Request body",
                "default": ""
              },
              {
                "name": "showHeaders",
                "text": "Show response headers",
                "default": "false"
              },
              {
                "name": "upload",
                "text": "File to upload as multipart/form-data; repeatable, use field=path to name the part",
                "default": "",
                "multiple": true
              },
              {
                "name": "uploadField",
                "text": "Form field name for the uploaded file",
                "default": "file"
              },
              {
                "name": "output",
                "text": "Write the response body to this file instead of stdout",
                "default": ""
              },
              {
                "name": "bodyFile",
                "text": "Send the contents of this file as the raw request body",
                "default": ""
              },
              {
                "name": "auth",
                "text": "Auth definitions from config.yaml, keyed by name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Config file holding the auth definitions",
                "default": ""
              },
              {
                "name": "config",
                "text": "Config profile to read the auth definitions from",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "auth-stream",
          "execute": [
            "stdin:${packageDir}/aux4-curl auth-stream values(provider, tokenFile, method, url, header*, concurrency, auth)"
          ],
          "help": {
            "text": "Stream NDJSON with OAuth2 authentication",
            "variables": [
              {
                "name": "provider",
                "text": "OAuth provider name"
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<provider>.json)",
                "default": ""
              },
              {
                "name": "method",
                "text": "HTTP method",
                "default": "POST"
              },
              {
                "name": "url",
                "text": "Request URL",
                "arg": true
              },
              {
                "name": "header",
                "text": "Request header (Name: Value)",
                "default": "",
                "multiple": true
              },
              {
                "name": "concurrency",
                "text": "Number of concurrent requests",
                "default": "1"
              },
              {
                "name": "auth",
                "text": "Auth definitions from config.yaml, keyed by name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Config file holding the auth definitions",
                "default": ""
              },
              {
                "name": "config",
                "text": "Config profile to read the auth definitions from",
                "default": ""
              }
            ]
          }
        }
      ]
    },
    {
      "name": "curl:oauth",
      "commands": [
        {
          "name": "login",
          "execute": [
            "${packageDir}/aux4-curl oauth-login values(provider, clientId, clientSecret, authUrl, tokenUrl, scopes, callbackPort, tokenFile, clientSecretRef, secretProvider, broker, brokerToken)"
          ],
          "help": {
            "text": "Authenticate with an OAuth2 provider (pass --broker to delegate the client secret to an OAuth broker)",
            "variables": [
              {
                "name": "provider",
                "text": "OAuth provider name",
                "arg": true
              },
              {
                "name": "clientId",
                "text": "OAuth client ID (not needed in --broker mode)",
                "default": ""
              },
              {
                "name": "clientSecret",
                "text": "OAuth client secret",
                "default": ""
              },
              {
                "name": "authUrl",
                "text": "Authorization URL (not needed in --broker mode)",
                "default": ""
              },
              {
                "name": "tokenUrl",
                "text": "Token exchange URL (not needed in --broker mode)",
                "default": ""
              },
              {
                "name": "scopes",
                "text": "Comma-separated scopes"
              },
              {
                "name": "callbackPort",
                "text": "Local callback server port",
                "default": "9876"
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<provider>.json)",
                "default": ""
              },
              {
                "name": "clientSecretRef",
                "text": "Secret reference holding the client secret (<provider>/<vault>/<item>/<field>)",
                "default": ""
              },
              {
                "name": "secretProvider",
                "text": "Secret provider that stores the client secret, access token and refresh token (e.g. aux4, os)",
                "default": ""
              },
              {
                "name": "broker",
                "text": "OAuth broker base URL (e.g. https://host/oauth-broker/api). When set, the broker builds the authorize URL and performs the code exchange and refresh, so this client never handles the client secret",
                "default": ""
              },
              {
                "name": "brokerToken",
                "text": "Bearer token to send to a secured broker (Authorization: Bearer <token>). Optional — supplied by the caller that knows the broker's auth (e.g. an aux4 identity token). Empty means no Authorization header is sent",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "token",
          "execute": [
            "${packageDir}/aux4-curl oauth-token values(provider, tokenFile, auth)"
          ],
          "help": {
            "text": "Get a valid access token, auto-refreshing if expired",
            "variables": [
              {
                "name": "provider",
                "text": "OAuth provider name",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<provider>.json)",
                "default": ""
              },
              {
                "name": "auth",
                "text": "Auth definitions from config.yaml, keyed by name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Config file holding the auth definitions",
                "default": ""
              },
              {
                "name": "config",
                "text": "Config profile to read the auth definitions from",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "status",
          "execute": [
            "${packageDir}/aux4-curl oauth-status values(provider, tokenFile)"
          ],
          "help": {
            "text": "Show OAuth token status for a provider",
            "variables": [
              {
                "name": "provider",
                "text": "OAuth provider name",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<provider>.json)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "logout",
          "execute": [
            "${packageDir}/aux4-curl oauth-logout values(provider, tokenFile)"
          ],
          "help": {
            "text": "Remove stored OAuth token for a provider",
            "variables": [
              {
                "name": "provider",
                "text": "OAuth provider name",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<provider>.json)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "set-token",
          "execute": [
            "${packageDir}/aux4-curl oauth-set-token values(provider, accessToken, tokenFile)"
          ],
          "help": {
            "text": "Store an API key or access token directly",
            "variables": [
              {
                "name": "provider",
                "text": "Provider name",
                "arg": true
              },
              {
                "name": "accessToken",
                "text": "API key or access token"
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<provider>.json)",
                "default": ""
              }
            ]
          }
        }
      ]
    },
    {
      "name": "curl:auth",
      "commands": [
        {
          "name": "add",
          "execute": [
            "${packageDir}/aux4-curl auth-add values(name, tokenUrl, preset, clientId, clientSecret, scopes, audience, method, contentType, credentialsIn, header*, body, tokenPath, expiresPath, expiresIn, authHeader, clientSecretRef, verify, tokenFile, configFile, config, save, secretProvider)"
          ],
          "help": {
            "text": "Register a named credential endpoint that issues tokens on demand",
            "variables": [
              {
                "name": "name",
                "text": "Name used to reference this auth in auth-request and auth-stream",
                "arg": true
              },
              {
                "name": "tokenUrl",
                "text": "URL of the endpoint that issues the token"
              },
              {
                "name": "preset",
                "text": "Defaults for how the token is requested and read back",
                "default": "client-credentials",
                "options": [
                  "client-credentials",
                  "client-credentials-basic",
                  "jwt",
                  "json"
                ]
              },
              {
                "name": "clientId",
                "text": "Client ID sent to the token endpoint",
                "default": ""
              },
              {
                "name": "clientSecret",
                "text": "Client secret sent to the token endpoint",
                "default": "",
                "hide": true
              },
              {
                "name": "scopes",
                "text": "Space-separated scopes to request",
                "default": ""
              },
              {
                "name": "audience",
                "text": "Audience to request, for providers that require one",
                "default": ""
              },
              {
                "name": "method",
                "text": "HTTP method for the token request",
                "default": "POST"
              },
              {
                "name": "contentType",
                "text": "How credentials are encoded in the body",
                "default": "",
                "options": [
                  "form",
                  "json"
                ]
              },
              {
                "name": "credentialsIn",
                "text": "Send credentials in the body or as HTTP Basic",
                "default": "",
                "options": [
                  "body",
                  "header"
                ]
              },
              {
                "name": "header",
                "text": "Extra header on the token request (Name: Value)",
                "default": "",
                "multiple": true
              },
              {
                "name": "body",
                "text": "Verbatim token request body, replacing the generated one",
                "default": ""
              },
              {
                "name": "tokenPath",
                "text": "JSON path to the token in the response (e.g. $.data.access_token)",
                "default": ""
              },
              {
                "name": "expiresPath",
                "text": "JSON path to the expiry in the response",
                "default": ""
              },
              {
                "name": "expiresIn",
                "text": "Fallback lifetime in seconds when the response and token say nothing",
                "default": ""
              },
              {
                "name": "authHeader",
                "text": "Header template for API calls",
                "default": "Authorization: Bearer ${token}"
              },
              {
                "name": "verify",
                "text": "Fetch a token immediately to check the configuration works",
                "default": "true",
                "options": [
                  "true",
                  "false"
                ]
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<name>.json)",
                "default": ""
              },
              {
                "name": "clientSecretRef",
                "text": "Secret reference holding the client secret (<provider>/<vault>/<item>/<field>)",
                "default": ""
              },
              {
                "name": "save",
                "text": "Write the definition to the config file instead of the local token store",
                "default": "false",
                "options": [
                  "true",
                  "false"
                ]
              },
              {
                "name": "configFile",
                "text": "Config file holding the auth definitions",
                "default": ""
              },
              {
                "name": "config",
                "text": "Config profile to write the definition under",
                "default": ""
              },
              {
                "name": "secretProvider",
                "text": "Secret provider that stores the client secret and the token (e.g. aux4, os)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "token",
          "execute": [
            "${packageDir}/aux4-curl oauth-token values(name, tokenFile, auth)"
          ],
          "help": {
            "text": "Get a valid token, fetching a new one if the stored one expired",
            "variables": [
              {
                "name": "name",
                "text": "Auth name",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<name>.json)",
                "default": ""
              },
              {
                "name": "auth",
                "text": "Auth definitions from config.yaml, keyed by name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Config file holding the auth definitions",
                "default": ""
              },
              {
                "name": "config",
                "text": "Config profile to read the auth definitions from",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "status",
          "execute": [
            "${packageDir}/aux4-curl oauth-status values(name, tokenFile)"
          ],
          "help": {
            "text": "Show the stored configuration and token state for an auth",
            "variables": [
              {
                "name": "name",
                "text": "Auth name",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<name>.json)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "remove",
          "execute": [
            "${packageDir}/aux4-curl oauth-logout values(name, tokenFile)"
          ],
          "help": {
            "text": "Remove a stored auth configuration and its cached token",
            "variables": [
              {
                "name": "name",
                "text": "Auth name",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Custom token file path (default: .oauth/<name>.json)",
                "default": ""
              }
            ]
          }
        }
      ]
    }
  ],
  "dependencies": [
    "aux4/config",
    "aux4/secret"
  ]
}
